":59,"end":93}]},{"style":"q2","spans":[{"verse":9,"start":94,"end":119}]},{"style":"q1","spans":[{"verse":9,"start":119,"end":119},{"verse":10,"start":0,"end":32}]},{"style":"q2","spans":[{"verse":10,"start":33,"end":70}]},{"style":"q1","spans":[{"verse":10,"start":71,"end":103}]},{"style":"q2","spans":[{"verse":10,"start":104,"end":139}]},{"style":"q1","spans":[{"verse":10,"start":139,"end":139},{"verse":11,"start":0,"end":31}]},{"style":"q2","spans":[{"verse":11,"start":32,"end":72}]},{"style":"q2","spans":[{"verse":11,"start":73,"end":114}]},{"style":"b","spans":[]},{"style":"q1","spans":[{"verse":11,"start":114,"end":114},{"verse":12,"start":0,"end":51}]},{"style":"q2","spans":[{"verse":12,"start":52,"end":94}]},{"style":"q1","spans":[{"verse":12,"start":95,"end":117}]},{"style":"q2","spans":[{"verse":12,"start":118,"end":144}]},{"style":"q2","spans":[{"verse":12,"start":145,"end":165}]},{"style":"q1","spans":[{"verse":12,"start":165,"end":165},{"verse":13,"start":0,"end":30}]},{"style":"q2","spans":[{"verse":13,"start":31,"end":59}]},{"style":"q1","spans":[{"verse":13,"start":60,"end":104}]},{"style":"q2","spans":[{"verse":13,"start":105,"end":152}]},{"style":"b","spans":[]},{"style":"q1","spans":[{"verse":13,"start":152,"end":152},{"verse":14,"start":0,"end":35}]},{"style":"q2","spans":[{"verse":14,"start":36,"end":60}]},{"style":"q1","spans":[{"verse":14,"start":61,"end":89}]},{"style":"q2","spans":[{"verse":14,"start":90,"end":132}]},{"style":"q1","spans":[{"verse":14,"start":132,"end":132},{"verse":15,"start":0,"end":16}]},{"style":"q2","spans":[{"verse":15,"start":17,"end":32}]},{"style":"q1","spans":[{"verse":15,"start":33,"end":63}]},{"style":"q2","spans":[{"verse":15,"start":64,"end":100}]},{"style":"q1","spans":[{"verse":15,"start":101,"end":129}]},{"style":"q2","spans":[{"verse":15,"start":130,"end":160}]},{"style":"q1","spans":[{"verse":15,"start":160,"end":160},{"verse":16,"start":0,"end":34}]},{"style":"q2","spans":[{"verse":16,"start":35,"end":64}]},{"style":"q2","spans":[{"verse":16,"start":65,"end":100}]},{"style":"q1","spans":[{"verse":16,"start":100,"end":100},{"verse":17,"start":0,"end":37}]},{"style":"q2","spans":[{"verse":17,"start":38,"end":73}]},{"style":"q2","spans":[{"verse":17,"start":74,"end":116}]},{"style":"q1","spans":[{"verse":17,"start":117,"end":157}]},{"style":"q2","spans":[{"verse":17,"start":158,"end":184}]},{"style":"q1","spans":[{"verse":17,"start":184,"end":184},{"verse":18,"start":0,"end":35}]},{"style":"q2","spans":[{"verse":18,"start":36,"end":64}]},{"style":"q2","spans":[{"verse":18,"start":65,"end":96}]},{"style":"q1","spans":[{"verse":18,"start":97,"end":129}]},{"style":"q2","spans":[{"verse":18,"start":130,"end":159}]},{"style":"b","spans":[]},{"style":"q1","spans":[{"verse":18,"start":160,"end":197}]},{"style":"q2","spans":[{"verse":18,"start":198,"end":228}]}],"offsetUnit":"unicode-codepoint"},{"number":2,"verses":[{"number":1,"text":"Gather yourselves, gather together, O shameful nation,","notes":[],"characterSpans":[]},{"number":2,"text":"before the decree takes effect and the day passes like chaff, before the burning anger of the LORD comes upon you, before the Day of the LORD’s anger comes upon you.","notes":[{"at":30,"marker":"f","caller":"+","text":"2:2 Hebrew is given birth","content":[{"type":"char","marker":"fr","content":["2:2 "]},{"type":"char","marker":"ft","content":["Hebrew "]},{"type":"char","marker":"fqa","content":["is given birth"]}]}],"characterSpans":[]},{"number":3,"text":"Seek the LORD, all you humble of the earth who carry out His justice. Seek righteousness; seek humility. Perhaps you will be sheltered on the day of the LORD’s anger.","notes":[],"characterSpans":[]},{"number":4,"text":"For Gaza will be abandoned, and Ashkelon left in ruins. Ashdod will be driven out at noon, and Ekron will be uprooted.","notes":[],"characterSpans":[]},{"number":5,"text":"Woe to the dwellers of the seacoast, O nation of the Cherethites! The word of the LORD is against you, O Canaan, land of the Philistines: “I will destroy you, and no one will be left.”","notes":[],"characterSpans":[]},{"number":6,"text":"So the seacoast will become a land of pastures, with wells for shepherds and folds for sheep.","notes":[{"at":58,"marker":"f","caller":"+","text":"2:6 Or caves or camps","content":[{"type":"char","marker":"fr","content":["2:6 "]},{"type":"char","marker":"ft","content":["Or "]},{"type":"char","marker":"fqa","content":["caves "]},{"type":"char","marker":"ft","content":["or "]},{"type":"char","marker":"fqa","content":["camps"]}]}],"characterSpans":[{"start":28,"end":37,"marker":"add"}]},{"number":7,"text":"The coast will belong to the remnant of the house of Judah; there they will find pasture. They will lie down in the evening among the houses of Ashkelon, for the LORD their God will attend to them and restore their captives.","notes":[{"at":224,"marker":"f","caller":"+","text":"2:7 Or their fortunes","content":[{"type":"char","marker":"fr","content":["2:7 "]},{"type":"char","marker":"ft","content":["Or "]},{"type":"char","marker":"fqa","content":["their fortunes"]}]}],"characterSpans":[]},{"number":8,"text":"“I have heard the reproach of Moab and the insults of the Ammonites, who have taunted My people and threatened their borders.","notes":[],"characterSpans":[]},{"number":9,"text":"Therefore, as surely as I live,” declares the LORD of Hosts, the God of Israel, “surely Moab will be like Sodom and the Ammonites like Gomorrah— a place of weeds and salt pits, a perpetual wasteland. The remnant of My people will plunder them; the remainder of My nation will dispossess them.”","notes":[],"characterSpans":[]},{"number":10,"text":"This they shall have in return for their pride, for taunting and mocking the people of the LORD of Hosts.","notes":[],"characterSpans":[]},{"number":11,"text":"The LORD will be terrifying to them when He starves all the gods of the earth. Then the nations of every shore will bow in worship to Him, each in its own place.","notes":[],"characterSpans":[]},{"number":12,"text":"“You too, O Cushites, will be slain by My sword.”","notes":[{"at":21,"marker":"f","caller":"+","text":"2:12 That is, people from the upper Nile region","content":[{"type":"char","marker":"fr","content":["2:12 "]},{"type":"char","marker":"ft","content":["That is, people from the upper Nile region"]}]}],"characterSpans":[]},{"number":13,"text":"And He will stretch out His hand against the north and destroy Assyria; He will make Nineveh a desolation, as dry as a desert.","notes":[],"characterSpans":[]},{"number":14,"text":"Herds will lie down in her midst, creatures of every kind. Both the desert owl and screech owl will roost atop her pillars. Their calls will sound from the window, but desolation will lie on the threshold, for He will expose the beams of cedar.","notes":[{"at":58,"marker":"f","caller":"+","text":"2:14 Hebrew beasts of every nation ","content":[{"type":"char","marker":"fr","content":["2:14 "]},{"type":"char","marker":"ft","content":["Hebrew "]},{"type":"char","marker":"fqa","content":["beasts of every nation "]}]},{"at":94,"marker":"f","caller":"+","text":"2:14 The precise identification of the animals rendered desert owl and screech owl is uncertain.","content":[{"type":"char","marker":"fr","content":["2:14 "]},{"type":"char","marker":"ft","content":["The precise identification of the animals rendered "]},{"type":"char","marker":"fqa","content":["desert owl "]},{"type":"char","marker":"ft","content":["and "]},{"type":"char","marker":"fqa","content":["screech owl "]},{"type":"char","marker":"ft","content":["is uncertain."]}]}],"characterSpans":[{"start":115,"end":122,"marker":"add"}]},{"number":15,"text":"This carefree city that dwells securely, that thinks to herself: “I am it, and there is none besides me,” what a ruin she has become, a resting place for beasts. Everyone who passes by her hisses and shakes his fist.","notes":[],"characterSpans":[{"start":68,"end":73,"marker":"add"},{"start":79,"end":87,"marker":"add"}]}],"headings":[{"afterVerse":null,"style":"s1","text":"A Call to Repentance","content":["A Call to Repentance"]},{"afterVerse":null,"style":"r","text":"(Joel 1:13–20; Amos 5:4–15; Luke 13:1–5)","content":["(",{"type":"ref","loc":"JOL 1:13-20","content":["Joel 1:13–20"]},"; ",{"type":"ref","loc":"AMO 5:4-15","content":["Amos 5:4–15"]},"; ",{"type":"ref","loc":"LUK 13:1-5","content":["Luke 13:1–5"]},")"]},{"afterVerse":3,"style":"s1","text":"Judgment on the Philistines","content":["Judgment on the Philistines"]},{"afterVerse":3,"style":"r","text":"(Jeremiah 47:1–7)","content":["(",{"type":"ref","loc":"JER 47:1-7","content":["Jeremiah 47:1–7"]},")"]},{"afterVerse":7,"style":"s1","text":"Judgment on Moab and Ammon","content":["Judgment on Moab and Ammon"]},{"afterVerse":7,"style":"r","text":"(Isaiah 16:1–14; Jeremiah 48:1–47)","content":["(",{"type":"ref","loc":"ISA 16:1-14","content":["Isaiah 16:1–14"]},"; ",{"type":"ref","loc":"JER 48:1-47","content":["Jeremiah 48:1–47"]},")"]},{"afterVerse":11,"style":"s1","text":"Judgment on Cush and Assyria","content":["Judgment on Cush and Assyria"]}],"paragraphs":[{"style":"q1","spans":[{"verse":1,"start":0,"end":35}]},{"style":"q2","spans":[{"verse":1,"start":36,"end":54}]},{"style":"q1","spans":[{"verse":1,"start":54,"end":54},{"verse":2,"start":0,"end":30}]},{"style":"q2","spans":[{"verse":2,"start":31,"end":61}]},{"style":"q1","spans":[{"verse":2,"start":62,"end":114}]},{"style":"q2","spans":[{"verse":2,"start":115,"end":165}]},{"style":"q1","spans":[{"verse":2,"start":165,"end":165},{"verse":3,"start":0,"end":42}]},{"style":"q2","spans":[{"verse":3,"start":43,"end":69}]},{"style":"q1","spans":[{"verse":3,"start":70,"end":104}]},{"style":"q2","spans":[{"verse":3,"start":105,"end":134}]},{"style":"q2","spans":[{"verse":3,"start":135,"end":166}]},{"style":"q1","spans":[{"verse":3,"start":166,"end":166},{"verse":4,"start":0,"end":27}]},{"style":"q2","spans":[{"verse":4,"start":28,"end":55}]},{