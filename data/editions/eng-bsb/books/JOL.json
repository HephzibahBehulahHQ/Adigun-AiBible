":81,"end":81},{"verse":30,"start":0,"end":52}]},{"style":"q2","spans":[{"verse":30,"start":53,"end":89}]},{"style":"q1","spans":[{"verse":30,"start":89,"end":89},{"verse":31,"start":0,"end":34}]},{"style":"q2","spans":[{"verse":31,"start":35,"end":56}]},{"style":"q2","spans":[{"verse":31,"start":57,"end":116}]},{"style":"q1","spans":[{"verse":31,"start":116,"end":116},{"verse":32,"start":0,"end":46}]},{"style":"q2","spans":[{"verse":32,"start":47,"end":61}]},{"style":"q1","spans":[{"verse":32,"start":62,"end":96}]},{"style":"q2","spans":[{"verse":32,"start":97,"end":149}]},{"style":"q2","spans":[{"verse":32,"start":150,"end":189}]}],"offsetUnit":"unicode-codepoint"},{"number":3,"verses":[{"number":1,"text":"“Yes, in those days and at that time, when I restore Judah and Jerusalem from captivity,","notes":[{"at":88,"marker":"f","caller":"+","text":"3:1 Or restore the fortunes of Judah and Jerusalem","content":[{"type":"char","marker":"fr","content":["3:1 "]},{"type":"char","marker":"ft","content":["Or "]},{"type":"char","marker":"fqa","content":["restore the fortunes of Judah and Jerusalem"]}]}],"characterSpans":[{"start":0,"end":1,"marker":"add"}]},{"number":2,"text":"I will gather all the nations and bring them down to the Valley of Jehoshaphat. There I will enter into judgment against them concerning My people, My inheritance, Israel, whom they have scattered among the nations as they divided up My land.","notes":[{"at":79,"marker":"f","caller":"+","text":"3:2 Jehoshaphat means the LORD judges; also in verse 12.","content":[{"type":"char","marker":"fr","content":["3:2 "]},{"type":"char","marker":"fqa","content":["Jehoshaphat "]},{"type":"char","marker":"ft","content":["means "]},{"type":"char","marker":"fqa","content":["the LORD judges"]},{"type":"char","marker":"ft","content":["; also in verse 12."]}]}],"characterSpans":[]},{"number":3,"text":"They cast lots for My people; they bartered a boy for a prostitute and sold a girl for wine to drink.","notes":[],"characterSpans":[]},{"number":4,"text":"Now what do you have against Me, O Tyre, Sidon, and all the regions of Philistia? Are you rendering against Me a recompense? If you retaliate against Me, I will swiftly and speedily return your recompense upon your heads.","notes":[],"characterSpans":[]},{"number":5,"text":"For you took My silver and gold and carried off My finest treasures to your temples.","notes":[{"at":84,"marker":"f","caller":"+","text":"3:5 Or palaces","content":[{"type":"char","marker":"fr","content":["3:5 "]},{"type":"char","marker":"ft","content":["Or "]},{"type":"char","marker":"fqa","content":["palaces"]}]}],"characterSpans":[]},{"number":6,"text":"You sold the people of Judah and Jerusalem to the Greeks, to send them far from their homeland.","notes":[{"at":57,"marker":"f","caller":"+","text":"3:6 Or to the peoples of Javan","content":[{"type":"char","marker":"fr","content":["3:6 "]},{"type":"char","marker":"ft","content":["Or "]},{"type":"char","marker":"fqa","content":["to the peoples of Javan"]}]}],"characterSpans":[]},{"number":7,"text":"Behold, I will rouse them from the places to which you sold them; I will return your recompense upon your heads.","notes":[],"characterSpans":[]},{"number":8,"text":"I will sell your sons and daughters into the hands of the people of Judah, and they will sell them to the Sabeans — to a distant nation.” Indeed, the LORD has spoken.","notes":[],"characterSpans":[]},{"number":9,"text":"Proclaim this among the nations: “Prepare for war; rouse the mighty men; let all the men of war advance and attack!","notes":[],"characterSpans":[]},{"number":10,"text":"Beat your plowshares into swords and your pruning hooks into spears. Let the weak say, ‘I am strong!’","notes":[],"characterSpans":[{"start":90,"end":92,"marker":"add"}]},{"number":11,"text":"Come quickly, all you surrounding nations, and gather yourselves. Bring down Your mighty ones, O LORD.","notes":[],"characterSpans":[{"start":18,"end":21,"marker":"add"}]},{"number":12,"text":"Let the nations be roused and advance to the Valley of Jehoshaphat, for there I will sit down to judge all the nations on every side.","notes":[],"characterSpans":[]},{"number":13,"text":"Swing the sickle, for the harvest is ripe. Come, trample the grapes, for the winepress is full; the wine vats overflow because their wickedness is great.","notes":[{"at":42,"marker":"f","caller":"+","text":"3:13 LXX the harvest has come; see also Mark 4:29.","content":[{"type":"char","marker":"fr","content":["3:13 "]},{"type":"char","marker":"ft","content":["LXX "]},{"type":"char","marker":"fqa","content":["the harvest has come"]},{"type":"char","marker":"ft","content":["; see also ",{"type":"ref","loc":"MRK 4:29","content":["Mark 4:29"]},"."]}]}],"characterSpans":[]},{"number":14,"text":"Multitudes, multitudes in the valley of decision! For the Day of the LORD is near in the valley of decision.","notes":[],"characterSpans":[]},{"number":15,"text":"The sun and moon will grow dark, and the stars will no longer shine.","notes":[],"characterSpans":[{"start":47,"end":51,"marker":"add"}]},{"number":16,"text":"The LORD will roar from Zion and raise His voice from Jerusalem; heaven and earth will tremble. But the LORD will be a refuge for His people, a stronghold for the people of Israel.","notes":[],"characterSpans":[]},{"number":17,"text":"Then you will know that I am the LORD your God, who dwells in Zion, My holy mountain. Jerusalem will be holy, never again to be overrun by foreigners.","notes":[],"characterSpans":[]},{"number":18,"text":"And in that day the mountains will drip with sweet wine, and the hills will flow with milk. All the streams of Judah will run with water, and a spring will flow from the house of the LORD to water the Valley of Acacias.","notes":[{"at":219,"marker":"f","caller":"+","text":"3:18 Or Valley of Shittim","content":[{"type":"char","marker":"fr","content":["3:18 "]},{"type":"char","marker":"ft","content":["Or "]},{"type":"char","marker":"fqa","content":["Valley of Shittim"]}]}],"characterSpans":[]},{"number":19,"text":"Egypt will become desolate, and Edom a desert wasteland, because of the violence done to the people of Judah, in whose land they shed innocent blood.","notes":[],"characterSpans":[]},{"number":20,"text":"But Judah will be inhabited forever, and Jerusalem from generation to generation.","notes":[],"characterSpans":[]},{"number":21,"text":"For I will avenge their blood, which I have not yet avenged.” For the LORD dwells in Zion.","notes":[{"at":60,"marker":"f","caller":"+","text":"3:21 Or For I will pardon their bloodguilt, which I have not yet pardoned.","content":[{"type":"char","marker":"fr","content":["3:21 "]},{"type":"char","marker":"ft","content":["Or "]},{"type":"char","marker":"fqa","content":["For I will pardon their bloodguilt, which I have not yet pardoned."]}]}],"characterSpans":[]}],"headings":[{"afterVerse":null,"style":"s1","text":"The LORD Judges the Nations","content":["The LORD Judges the Nations"]},{"afterVerse":16,"style":"s1","text":"Blessings for God’s People","content":["Blessings for God’s People"]}],"paragraphs":[{"style":"q1","spans":[{"verse":1,"start":0,"end":37}]},{"style":"q2","spans":[{"verse":1,"start":38,"end":88}]},{"style":"q1","spans":[{"verse":1,"start":88,"end":88},{"verse":2,"start":0,"end":29}]},{"style":"q2","spans":[{"verse":2,"start":30,"end":79}]},{"style":"q1","spans":[{"verse":2,"start":80,"end":125}]},{"style":"q2","spans":[{"verse":2,"start":126,"end":171}]},{"style":"q1","spans":[{"verse":2,"start":172,"end":214}]},{"style":"q2","spans":[{"verse":2,"start":215,"end":242}]},{"style":"q1","spans":[{"verse":2,"start":242,"end":242},{"verse":3,"start":0,"end":29}]},{"style":"q2","spans":[{"verse":3,"start":30,"end":66}]},{"style":"q2","spans":[{"verse":3,"start":67,"end":101}]},{"style":"p","spans":[{"verse":3,"start":101,"end":101},{"verse":4,"start":0,"end":221},{"verse":5,"start":0,"end":84},{"verse":6,"start":0,"end":95}]},{"style":"p","spans":[