{
  "name": "adigun-aibible",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "content:import": "node scripts/import-corpus.mjs",
    "content:validate": "node scripts/validate-corpus.mjs",
    "content:coverage": "node scripts/validate-corpus.mjs",
    "build": "npm run typecheck && node scripts/prepare-content.mjs && vite build && node scripts/finalize-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "check": "npm run typecheck && npm run lint && npm test && npm run content:validate && npm run build",
    "checkpoint": "node scripts/checkpoint.mjs",
    "checkpoint:watch": "node scripts/checkpoint.mjs --watch"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "24.10.1",
    "@vitejs/plugin-react": "6.0.2",
    "@playwright/test": "1.62.1",
    "eslint": "9.39.1",
    "typescript-eslint": "8.48.1",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
